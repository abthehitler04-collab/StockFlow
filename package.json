{
  "name": "stockflow-enterprise",
  "version": "2.0.0-centralized",
  "description": "StockFlow Enterprise — Centralized multi-user warehouse and after-sales inventory management",
  "private": true,
  "scripts": {
    "start": "python -m http.server 3000 --bind 0.0.0.0",
    "test": "node --test tests/**/*.test.js",
    "validate": "node --check sw.js && node -e \"new Function(require('fs').readFileSync('google-apps-script/Code.gs','utf8'))\" && echo 'Syntax OK'",
    "serve": "python -m http.server 4175 --bind 127.0.0.1",
    "deploy:local": "pwsh -File deploy.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "node-fetch": "^3.3.2"
  },
  "keywords": ["stockflow", "inventory", "warehouse", "google-sheets", "pwa"],
  "license": "UNLICENSED"
}
